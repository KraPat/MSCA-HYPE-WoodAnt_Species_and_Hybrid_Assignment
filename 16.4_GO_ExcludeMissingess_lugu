## Now, we use within-group robust outlier rule so a sample is judged against its own group, not against all species combined.
#One reasonable screening rule is to flag values more than three scaled median absolute deviations (MADs) above that group’s median.
# This flags candidates for review; it does not automatically mean they should be excluded.

#in R
flagged_imiss <- imiss %>%
  group_by(group) %>%
  mutate(
    group_median = median(F_MISS, na.rm = TRUE),
    group_MAD = mad(
      F_MISS,
      center = group_median,
      constant = 1.4826,
      na.rm = TRUE
    ),
    MAD_cutoff = group_median + 3 * group_MAD,
    extreme_MAD = case_when(
      is.na(group_MAD) | group_MAD == 0 ~ FALSE,
      TRUE ~ F_MISS > MAD_cutoff
    )
  ) %>%
  ungroup()

# Group summaries, including the number flagged
outlier_summary <- flagged_imiss %>%
  group_by(group) %>%
  summarise(
    n_samples = n_distinct(INDV),
    median_F_MISS = median(F_MISS, na.rm = TRUE),
    maximum_F_MISS = max(F_MISS, na.rm = TRUE),
    MAD_cutoff = first(MAD_cutoff),
    n_flagged = sum(extreme_MAD),
    .groups = "drop"
  )

# The flagged individuals and their missingness values
outlier_results <- flagged_imiss %>%
  filter(extreme_MAD) %>%
  select(group, INDV, F_MISS, N_DATA, N_MISS,
         group_median, group_MAD, MAD_cutoff)

outlier_summary
outlier_results

write.csv(outlier_summary, "imiss_outlier_summary.csv", row.names = FALSE)
write.csv(outlier_results, "imiss_flagged_samples.csv", row.names = FALSE)


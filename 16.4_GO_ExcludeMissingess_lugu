!/usr/bin/env bash
#SBATCH --job-name=lugu_qc
#SBATCH --account=project_2009316
#SBATCH --partition=small
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/project_2009316/EuSamples/06.VCF/filt/SpeciesSubsetVCF/species_masked_QC/slurm_logs/%x_%j.out
#SBATCH --error=/scratch/project_2009316/EuSamples/06.VCF/filt/SpeciesSubsetVCF/species_masked_QC/slurm_logs/%x_%j.err

# Lugu-only pipeline:
# 1) Exclude samples with missing_GT_fraction_after > 0.60 in the supplied TSV.
# 2) Recalculate AN, AC, AF, and NS from retained GT calls.
# 3) Recalculate F_MISSING and retain sites with <=10% missing genotypes.
# 4) Run VCFtools --missing-indv on the final site-filtered VCF.
# If no sample exceeds 60%, all Lugu samples are retained.
# Add cluster-specific account/partition and software module/conda setup below.

set -euo pipefail
module load bio-apps/v202603
module load bcftools
module load vcftools

BASE="/scratch/project_2009316/EuSamples/06.VCF/filt/SpeciesSubsetVCF/species_masked_QC"
INPUT_VCF="${BASE}/lugu/lugu.DP8.GQ20.masked.vcf.gz"
MISSINGNESS_TSV="${BASE}/lugu/lugu.DP8.GQ20.missingness_before_after.tsv"

EXCL_DIR="${BASE}/excluded60_recalcAN/lugu"
SITE_DIR="${BASE}/siteMiss10/lugu"
MISS_DIR="${BASE}/final_missingness/lugu"
EXCL_VCF="${EXCL_DIR}/lugu.DP8.GQ20.excl60.recalcAN.vcf.gz"
SITE_VCF="${SITE_DIR}/lugu.DP8.GQ20.excl60.siteMiss10.recalcAN.vcf.gz"
MISS_PREFIX="${MISS_DIR}/lugu.DP8.GQ20.excl60.siteMiss10"
IMISS="${MISS_PREFIX}.imiss"
EXCLUDE_FILE="${EXCL_DIR}/lugu.excluded_gt_missing_gt60pct.samples.txt"

mkdir -p "$EXCL_DIR" "$SITE_DIR" "$MISS_DIR"

for tool in bcftools vcftools awk; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "ERROR: Required tool '$tool' is not on PATH; load/activate the correct environment." >&2
    exit 1
  fi
done
if [[ ! -r "$INPUT_VCF" ]]; then
  echo "ERROR: Input VCF not found/readable: $INPUT_VCF" >&2
  exit 1
fi
if [[ ! -r "$MISSINGNESS_TSV" ]]; then
  echo "ERROR: Missingness TSV not found/readable: $MISSINGNESS_TSV" >&2
  exit 1
fi
for output in "$EXCL_VCF" "$SITE_VCF" "$IMISS"; do
  if [[ -e "$output" ]]; then
    echo "ERROR: Output already exists; move/remove it before rerunning: $output" >&2
    exit 1
  fi
done

JOB_TMP="${SLURM_TMPDIR:-$EXCL_DIR}"
mkdir -p "$JOB_TMP"
SUBSET_TMP="${JOB_TMP}/lugu.subset.${SLURM_JOB_ID:-manual}.tmp.vcf.gz"
cleanup() {
  rm -f "$SUBSET_TMP" "$SUBSET_TMP.csi" "$SUBSET_TMP.tbi"
}
trap cleanup EXIT

# Extract sample IDs whose post-mask missingness is strictly greater than 60%.
# Accept either proportions (0.60) or percentages (60) in the TSV.
awk -F '\t' '
  NR == 1 {
    for (i = 1; i <= NF; i++) {
      gsub(/\r$/, "", $i)
      if ($i == "sample_id") sample_col = i
      if ($i == "missing_GT_fraction_after") missing_col = i
    }
    if (!sample_col || !missing_col) {
      print "ERROR: TSV must contain sample_id and missing_GT_fraction_after columns" > "/dev/stderr"
      exit 2
    }
    next
  }
  {
    sample = $sample_col
    value = $missing_col
    gsub(/\r$/, "", sample)
    gsub(/%/, "", value)
    if (sample == "" || value == "" || value == "NA") next
    if (value + 0 > 1) value = value / 100
    if (value + 0 > 0.60) print sample
  }
' "$MISSINGNESS_TSV" | sort -u > "$EXCLUDE_FILE"

N_BEFORE="$(bcftools query -l "$INPUT_VCF" | wc -l | tr -d ' ')"
N_EXCLUDE="$(wc -l < "$EXCLUDE_FILE" | tr -d ' ')"

# Validate every requested exclusion ID against the VCF sample names.
while IFS= read -r SAMPLE_ID; do
  if ! bcftools query -l "$INPUT_VCF" | grep -Fqx -- "$SAMPLE_ID"; then
    echo "ERROR: TSV exclusion sample is absent from the Lugu VCF: ${SAMPLE_ID}" >&2
    exit 1
  fi
done < "$EXCLUDE_FILE"

if (( N_EXCLUDE >= N_BEFORE )); then
  echo "ERROR: Exclusion count (${N_EXCLUDE}) is not smaller than VCF sample count (${N_BEFORE})." >&2
  exit 1
fi
N_EXPECTED=$((N_BEFORE - N_EXCLUDE))
echo "Lugu samples before exclusion: ${N_BEFORE}; >60% missing: ${N_EXCLUDE}; expected retained: ${N_EXPECTED}"
if (( N_EXCLUDE == 0 )); then
  echo "No samples exceed 60%; retaining all Lugu samples."
else
  echo "Excluded sample IDs:"
  cat "$EXCLUDE_FILE"
fi

# Exclude listed samples. If the exclusion list is empty, retain all samples.
if (( N_EXCLUDE > 0 )); then
  bcftools view --threads "${SLURM_CPUS_PER_TASK:-4}" -S "^${EXCLUDE_FILE}" -Oz -o "$SUBSET_TMP" "$INPUT_VCF"
else
  bcftools view --threads "${SLURM_CPUS_PER_TASK:-4}" -Oz -o "$SUBSET_TMP" "$INPUT_VCF"
fi

# Recalculate allele-count/frequency tags from the retained GT calls.
bcftools +fill-tags "$SUBSET_TMP" -Oz -o "$EXCL_VCF" -- -t AN,AC,AF,NS
bcftools index -f "$EXCL_VCF"

# Calculate per-site genotype missingness in the retained Lugu samples and filter at 10%.
bcftools +fill-tags "$EXCL_VCF" -Ou -- -t F_MISSING | bcftools view --threads "${SLURM_CPUS_PER_TASK:-4}" -i 'INFO/F_MISSING<=0.10' -Oz -o "$SITE_VCF"
bcftools index -f "$SITE_VCF"

N_AFTER="$(bcftools query -l "$SITE_VCF" | wc -l | tr -d ' ')"
if [[ "$N_AFTER" -ne "$N_EXPECTED" ]]; then
  echo "ERROR: Expected ${N_EXPECTED} samples after exclusion, found ${N_AFTER}." >&2
  exit 1
fi
if ! bcftools query -f '%INFO/F_MISSING\n' "$SITE_VCF" | awk '$1 > 0.100001 { bad=1 } END { exit bad }'; then
  echo "ERROR: At least one retained site exceeds 10% missingness." >&2
  exit 1
fi

# Final per-sample missingness report on the site-filtered VCF.
vcftools --gzvcf "$SITE_VCF" --missing-indv --out "$MISS_PREFIX"
if [[ ! -s "$IMISS" ]]; then
  echo "ERROR: VCFtools did not create a non-empty report: $IMISS" >&2
  exit 1
fi
N_REPORT=$(( $(wc -l < "$IMISS") - 1 ))
if [[ "$N_REPORT" -ne "$N_AFTER" ]]; then
  echo "ERROR: Expected ${N_AFTER} sample rows in ${IMISS}, found ${N_REPORT}." >&2
  exit 1
fi

N_SITES_EXCL="$(bcftools index -n "$EXCL_VCF")"
N_SITES_FINAL="$(bcftools index -n "$SITE_VCF")"
echo "Allele-count VCF: ${EXCL_VCF} (${N_SITES_EXCL} records)"
echo "Final site-filtered VCF: ${SITE_VCF} (${N_SITES_FINAL} records)"
echo "Final sample missingness report: ${IMISS} (${N_REPORT} samples)"
echo "Completed Lugu pipeline."


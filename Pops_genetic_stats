#These files are used for PI, FST, etc.

# A) Heterozygosity
# Individual heterozygosity (per sample)
# The idea: proportion of heterozygous genotypes across loci.
# We use PLINK:
plink --vcf all_samples_filtered.vcf \
  --double-id \
  --allow-extra-chr \
  --het \
  --out het_stats

# Output het_stats.het gives:
# observed number of homozygous / heterozygous genotypes per individual
# F-statistic per individual (inbreeding coefficient)


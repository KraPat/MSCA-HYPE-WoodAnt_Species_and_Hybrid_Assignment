#!/bin/bash -l
#SBATCH -J EuSamp_allsites_vcf_mac2
#SBATCH -o /scratch/project_2009316/EuSamples/06.VCF/gvcf/logs/allsites_vcf_mac2_%j_%a.out
#SBATCH -e /scratch/project_2009316/EuSamples/06.VCF/gvcf/logs/allsites_vcf_mac2_%j_%a.err
#SBATCH --account=project_2009316
#SBATCH -t 70:00:00
#SBATCH -p small
#SBATCH --array=1-25
#SBATCH --ntasks 1
#SBATCH --mem=8G
#SBATCH --mail-type=END

#
# 0. Load modules and set directory and variables -----------------------------
#

set -euo pipefail
module load bio-apps/v202603
module load bcftools
module load vcftools

# go to directory where raw gvcf for each chroms will be produced
cd /scratch/project_2009316/EuSamples/06.VCF/gvcf/raw/

# Get chroms ID
REF=/scratch/project_2009316/rufaRefGenome
FASTA=$REF/Frufa_PR_May2026.fa
CHROMS=/scratch/project_2009316/rufaRefGenome/chromosomes_no03_no23.list
BAMLIST=/scratch/project_2009316/EuSamples/05.BAM/BAM_final/BAMlist3
REMOVE=/scratch/project_2009316/EuSamples/06.VCF/gvcf/removeInds.list

chroms=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$CHROMS")
if [[ -z "$chroms" ]]; then
    echo "No chromosome found for array task ${SLURM_ARRAY_TASK_ID}" >&2
    exit 1
fi

# write gvcf
echo "Writing gvcf for ${chroms} ..."

bcftools mpileup -f "$FASTA" -b "$BAMLIST" -r "$chroms" | \
    bcftools call -m -Oz -f GQ -o "${chroms}_allsamples.vcf.gz"

n_all=$(bcftools query -l "${chroms}_allsamples.vcf.gz" | wc -l)
if [[ "$n_all" -ne 385 ]]; then
    echo "Expected 385 called samples, found $n_all" >&2
    exit 1
fi

# Set DP thresholds & filter missing data
#Max depth threshold: Calculate average of the mean depths and multiply by two -> follow the logic from the variant site vcf filtering where 
#sites with >2x mean ind depth are set as missing.
# IDEPTHPATH=/scratch/project_2009316/EuSamples/06.VCF/filt
# cat $IDEPTHPATH/all_samples.norm.dec.sor.nopha.SNPQ30.biall.fixedHeader.idepth
# | grep -v "INDV" | awk '{ total += $3; count++ } END { print total/count }' #16.3052
# 16.3052*2= ca. 32.61; set max avg depth to 33x.

mindp=770 #2*385 samples
maxdp=12705 #33*385 samples

echo "Filtering VCF by depth ..."
bcftools view -Ou "${chroms}_allsamples.vcf.gz" | \
    bcftools filter -e "DP < ${mindp} | DP > ${maxdp}" --set-GTs . -Oz \
    -o "${chroms}_allsamples_meanDP${mindp}-${maxdp}.vcf.gz"

bcftools index -t "${chroms}_allsamples_meanDP${mindp}-${maxdp}.vcf.gz"


echo "Removing low-coverage individuals ..."
# CHANGED: this is a vcftools command, not a bcftools command.
vcftools --gzvcf "${chroms}_allsamples_meanDP${mindp}-${maxdp}.vcf.gz" \
    --remove "$REMOVE" --recode --recode-INFO-all --stdout | \
    bgzip -c > "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}.vcf.gz"

bcftools index -t "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}.vcf.gz"

n_kept=$(bcftools query -l "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}.vcf.gz" | wc -l)
if [[ "$n_kept" -ne 376 ]]; then
    echo "Expected 376 retained samples, found $n_kept" >&2
    exit 1
fi


echo "Filtering missing data per site ..."
bcftools view -Ou "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}.vcf.gz" | \
    bcftools filter -e "F_MISSING > 0.5" -Oz \
    -o "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc.vcf.gz"  


#---
# Now, 2 VCFS will be made, one with only invariant sites and one with only variants\
# these two are then combined to make a vcf will all sites (gvcf)
# to combine they must both be indexed then combined with bcftools "concat"

echo "Creating vcf for invariant sites ..."
# Create a filtered VCF containing only invariant sites
vcftools --gzvcf "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc.vcf.gz" \
    --max-maf 0 --recode --recode-INFO-all --stdout | \
    bgzip -c > "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_invar.vcf.gz"  #

echo "Creating VCF for variant sites ..."
# Create a filtered VCF containing only variant sites, keep SNPqual >= 30 and filter out HW excess and singletons
vcftools --gzvcf "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc.vcf.gz" \
    --mac 2 --hwe 0.001 --minQ 30 --recode --recode-INFO-all --stdout | \
    bgzip -c > "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_var.vcf.gz"  #


# Index both vcfs using tabix
tabix ${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_invar.vcf.gz
tabix ${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_var.vcf.gz

echo "Combining VCFs for ${chroms} ..."
bcftools concat \
    --allow-overlaps \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_invar.vcf.gz" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_var.vcf.gz" \
    -Oz -o "${chroms}_highCovSamples_filtered.vcf.gz"  

# Index for concat afterwards
tabix ${chroms}_highCovSamples_filtered.vcf.gz

echo "Removing temp files ..."
# Remove temp files
rm -f "${chroms}_allsamples.vcf.gz" \
    "${chroms}_allsamples_meanDP${mindp}-${maxdp}.vcf.gz" \
    "${chroms}_allsamples_meanDP${mindp}-${maxdp}.vcf.gz.tbi" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}.vcf.gz" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}.vcf.gz.tbi" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc.vcf.gz" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_invar.vcf.gz" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_invar.vcf.gz.tbi" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_var.vcf.gz" \
    "${chroms}_highCovSamples_meanDP${mindp}-${maxdp}_maxNA50perc_var.vcf.gz.tbi"

# End bash script
------------------------------


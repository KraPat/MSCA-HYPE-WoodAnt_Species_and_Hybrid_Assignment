#SBATCH --ntasks 4
#SBATCH --mem=8G
#SBATCH --mail-type=BEGIN,END,FAIL

set -euo pipefail

module load biokit
cd /scratch/project_2009316/EuSamples/07.VCF_mtDNA/filt

# --------------------------
# Parameters

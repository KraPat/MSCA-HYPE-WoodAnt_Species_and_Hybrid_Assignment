VCF1=all_samples_mtDNA.norm.dec.sor.nopha.SNPQ30.biall.vcf.gz
VCF2=all_samples_mtDNA.norm.dec.sor.nopha.SNPQ30.biall.374Inds.vcf.gz

# Start log file
echo "=== Filtering log ===" > "$FilterData_Output"
echo "VCF1: $VCF1" >> "$FilterData_Output"
echo "VCF2: $VCF2" >> "$FilterData_Output"
echo >> "$FilterData_Output"

# --------------------------
# 1. Filter out individuals
# --------------------------
echo "Step 1: Removing individuals listed in removeInds.list2" >> "$FilterData_Output"

# vcftools writes a lot to stderr; capture that into the log
vcftools --gzvcf "$VCF1" \
         --remove removeInds.list2 \
         --recode --recode-INFO-all \
         --stdout | bgzip > "$VCF2"

# Index VCF2
bcftools index -t "$VCF2"

{
    echo "number of inds (should be 374)..."
    bcftools query -l "$VCF2" | wc -l

    echo "number of variants ..."
    bcftools index -n "$VCF2"
} >> "$FilterData_Output"

echo >> "$FilterData_Output"


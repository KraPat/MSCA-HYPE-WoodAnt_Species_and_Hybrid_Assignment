from pathlib import Path
w = Path(os.environ['WORK'])
known = set((w / 'all_samples.txt').read_text().splitlines())
samples = []
for line in Path(os.environ['LIST']).read_text(encoding='utf-8-sig').splitlines():
    sample = line.strip()
    if not sample or sample.startswith('#'):
        continue
    if len(sample.split()) != 1:
        raise SystemExit(f'ERROR: Expected one sample ID per line: {sample!r}')
    samples.append(sample)
if not samples:
    raise SystemExit('ERROR: Empty species sample list.')
if len(samples) != len(set(samples)):
    raise SystemExit('ERROR: Duplicate IDs in species sample list.')
missing = sorted(set(samples) - known)
if missing:
    raise SystemExit('ERROR: IDs not in VCF: ' + ', '.join(missing))
(w / 'samples.txt').write_text('\n'.join(samples) + '\n')
print(f"{os.environ['SPECIES']}: validated {len(samples)} samples", flush=True)
PY

# Preserve ALL records and allele representations for comparable initial QC.
# Do not trim ALT alleles or drop sites monomorphic within this species yet.
# bcftools recalculates existing INFO/AC and INFO/AN during sample subsetting.
bcftools view -S "$WORK/samples.txt" -Oz -o "$WORK/subset.vcf.gz" "$VCF"
bcftools index -f "$WORK/subset.vcf.gz"
bcftools query -l "$WORK/subset.vcf.gz" > "$WORK/output_samples.txt"
bcftools stats -s - "$WORK/subset.vcf.gz" > "$WORK/bcftools_stats.txt"
bcftools view -h "$WORK/subset.vcf.gz" > "$WORK/subset_header.txt"

# Query GT plus optional FORMAT/DP and FORMAT/GQ only when present.
# Stream genotypes into Python so the whole genotype matrix is never held in RAM.
python3 - <<'PY'
import os
import re
import csv
import math
import subprocess
from pathlib import Path

w = Path(os.environ['WORK'])
species = os.environ['SPECIES']
samples = (w / 'output_samples.txt').read_text().splitlines()
header = (w / 'subset_header.txt').read_text()
if not re.search(r'^##FORMAT=<ID=GT[,>]', header, re.M):
    raise SystemExit('ERROR: VCF has no FORMAT/GT.')
has_dp = bool(re.search(r'^##FORMAT=<ID=DP[,>]', header, re.M))
has_gq = bool(re.search(r'^##FORMAT=<ID=GQ[,>]', header, re.M))
fmt = '%CHROM\t%POS\t%REF\t%ALT[\t%GT'
if has_dp:
    fmt += '\t%DP'
if has_gq:
    fmt += '\t%GQ'
fmt += ']\n'
width = 1 + int(has_dp) + int(has_gq)
metrics = [dict(n=0, complete=0, partial=0, absent=0, diploid=0, het=0,
                dp_n=0, dp_sum=0.0, dp_lt5=0, dp_lt10=0,
                gq_n=0, gq_sum=0.0, gq_lt20=0, gq_lt30=0) for _ in samples]

def numeric(text):
    try:
        value = float(text)
        return value if math.isfinite(value) and value >= 0 else None
    except ValueError:
        return None

    # These include sites monomorphic or wholly missing within a species.
    if len(ref) != 1 or len(alt) != 1 or ref.upper() not in 'ACGT' or alt.upper() not in 'ACGT':
        continue
    for i, m in enumerate(metrics):
        offset = 4 + i * width
        gt = fields[offset]
        alleles = re.split(r'[/|]', gt)
        missing = sum(a == '.' for a in alleles)
        m['n'] += 1
        if missing == len(alleles):
            m['absent'] += 1
            continue
        if missing:
            m['partial'] += 1
            continue
        m['complete'] += 1
        if len(alleles) == 2:
            m['diploid'] += 1
            m['het'] += int(alleles[0] != alleles[1])
        j = offset + 1
        if has_dp:
            dp = numeric(fields[j])
            j += 1
            if dp is not None:
                m['dp_n'] += 1
                m['dp_sum'] += dp
                m['dp_lt5'] += int(dp < 5)

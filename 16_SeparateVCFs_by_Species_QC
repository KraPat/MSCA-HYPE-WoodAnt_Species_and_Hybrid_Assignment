#!/usr/bin/env python3
"""Flag samples for investigation from the species/group sample_QC.tsv reports.

Requires Python 3 standard library only. Does not change a VCF or remove samples.
Example:
python3 flag_sample_qc.py --input all_groups.sample_QC.tsv --outdir qc_flags
Multiple inputs:
python3 flag_sample_qc.py --input species_QC/*/*.sample_QC.tsv --outdir qc_flags
Use --help for configurable thresholds. All thresholds are exploratory defaults,
not validated exclusion criteria. Assess BAM QC and biological context as well.
"""
import argparse
import csv
import math
import statistics
from collections import defaultdict
from pathlib import Path


def number(value):
    try:
        x = float(value)
        return x if math.isfinite(x) else None
    except (TypeError, ValueError):
        return None


def quantile(values, p):
    values = sorted(values)
    position = (len(values) - 1) * p
    low = math.floor(position)
    high = math.ceil(position)
    return values[low] + (values[high] - values[low]) * (position - low)


def write_table(path, fields, rows):
    with path.open('w', newline='') as handle:
        writer = csv.DictWriter(handle, fieldnames=fields, delimiter='\t', extrasaction='ignore')
        writer.writeheader()
        writer.writerows(rows)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--input', nargs='+', required=True, help='One or more sample_QC.tsv files; shell wildcards are accepted.')
    parser.add_argument('--outdir', required=True)
    parser.add_argument('--missing-max', type=float, default=0.20, help='Flag missing_GT_fraction above this value (default 0.20).')
    parser.add_argument('--mean-dp-min', type=float, default=10.0, help='Flag mean called-genotype DP below this value (default 10).')
    parser.add_argument('--mean-gq-min', type=float, default=20.0, help='Flag mean called-genotype GQ below this value (default 20).')
    parser.add_argument('--low-dp-fraction-max', type=float, default=0.20, help='Flag fraction_DP_lt10 above this value (default 0.20).')
    parser.add_argument('--low-gq-fraction-max', type=float, default=0.20, help='Flag fraction_GQ_lt20 above this value (default 0.20).')
    parser.add_argument('--tag-coverage-min', type=float, default=0.90, help='Flag DP/GQ available for less than this fraction of complete GT (default 0.90).')
    parser.add_argument('--min-group-n', type=int, default=5, help='Minimum usable samples for within-group outlier checks (default 5).')
    parser.add_argument('--outlier-z', type=float, default=3.5, help='Robust outlier cutoff using median and scaled MAD (default 3.5).')
    parser.add_argument('--skip-het-groups', nargs='*', default=[], help='Group labels to omit from relative heterozygosity checks.')
    args = parser.parse_args()
    for name in ('missing_max', 'low_dp_fraction_max', 'low_gq_fraction_max', 'tag_coverage_min'):
        if not 0 <= getattr(args, name) <= 1:
            parser.error(f'--{name.replace("_", "-")} must be between 0 and 1.')
    if args.min_group_n < 3 or args.outlier_z <= 0 or args.mean_dp_min < 0 or args.mean_gq_min < 0:
        parser.error('Require min-group-n >= 3, outlier-z > 0, and nonnegative DP/GQ thresholds.')

    required = ['sample_id', 'n_biallelic_snp_records', 'n_complete_GT',
                'missing_GT_fraction', 'heterozygosity_called_diploid_SNPs',
                'n_called_GT_with_DP', 'mean_DP_called_GT', 'fraction_DP_lt10',
                'n_called_GT_with_GQ', 'mean_GQ_called_GT', 'fraction_GQ_lt20']
    rows = []
    seen = {}
    numeric_fields = required[1:] + ['n_complete_diploid_GT']
    for filename in args.input:
        with Path(filename).open(newline='', encoding='utf-8-sig') as handle:
            reader = csv.DictReader(handle, delimiter='\t')
            fields = reader.fieldnames or []
            group_column = 'group' if 'group' in fields else 'species' if 'species' in fields else None
            missing = [column for column in required if column not in fields]
            if missing or group_column is None:
                parser.error(f'{filename}: missing required columns: {missing}; group/species column required.')
            for line_number, raw in enumerate(reader, 2):
                sample = (raw.get('sample_id') or '').strip()
                group = (raw.get(group_column) or '').strip()
                if not sample or not group:
                    parser.error(f'{filename}:{line_number}: empty sample or group label.')
                row = dict(raw)
                row['group'] = group
                row['sample_id'] = sample
                key = (group, sample)
                signature = tuple(row.get(field, '') for field in numeric_fields)
                if key in seen:
                    if seen[key] != signature:
                        parser.error(f'Conflicting duplicate rows for group/sample {key}. Do not combine different QC runs.')
                    continue
                seen[key] = signature
                row['_numbers'] = {field: number(row.get(field)) for field in numeric_fields}
                row['_flags'] = []
                row['_categories'] = set()
                row['_missing'] = []
                rows.append(row)
    if not rows:
        parser.error('No sample rows found.')

    def flag(row, category, message):
        row['_flags'].append(message)
        row['_categories'].add(category)

    def threshold(row, field, cutoff, direction, category, label):
        value = row['_numbers'].get(field)
        if value is None:
            row['_missing'].append(field)
        elif (direction == 'high' and value > cutoff) or (direction == 'low' and value < cutoff):
            flag(row, category, f'{label}: {value:.4g} {">" if direction == "high" else "<"} {cutoff:.4g}')

    for row in rows:
        n = row['_numbers']['n_biallelic_snp_records']
        called = row['_numbers']['n_complete_GT']
        if n is None or n <= 0:
            flag(row, 'data', 'No valid positive SNP-record denominator')
        if called is None or called <= 0:
            flag(row, 'data', 'No complete genotype calls or missing complete-call count')
        threshold(row, 'missing_GT_fraction', args.missing_max, 'high', 'missingness', 'High missingness')
        threshold(row, 'mean_DP_called_GT', args.mean_dp_min, 'low', 'depth', 'Low mean DP')
        threshold(row, 'fraction_DP_lt10', args.low_dp_fraction_max, 'high', 'depth', 'Many DP<10 calls')
        threshold(row, 'mean_GQ_called_GT', args.mean_gq_min, 'low', 'genotype_quality', 'Low mean GQ')
        threshold(row, 'fraction_GQ_lt20', args.low_gq_fraction_max, 'high', 'genotype_quality', 'Many GQ<20 calls')
        if called is not None and called > 0:
            for tag in ('DP', 'GQ'):
                count = row['_numbers'][f'n_called_GT_with_{tag}']
                if count is None:
                    row['_missing'].append(f'n_called_GT_with_{tag}')
                elif count / called < args.tag_coverage_min:
                    flag(row, 'tag_availability', f'{tag} available for only {count / called:.1%} of complete GT')
                elif count > called:
                    flag(row, 'data', f'{tag} count exceeds complete genotype count')
        if row['_numbers']['heterozygosity_called_diploid_SNPs'] is None:
            row['_missing'].append('heterozygosity_called_diploid_SNPs')

    groups = defaultdict(list)
    for row in rows:
        groups[row['group']].append(row)
    summaries = []
    relative_checks = [
        ('missing_GT_fraction', 'high', 'missingness'),
        ('mean_DP_called_GT', 'both', 'depth'),
        ('mean_GQ_called_GT', 'low', 'genotype_quality'),
        ('heterozygosity_called_diploid_SNPs', 'both', 'heterozygosity'),
    ]
    for group, members in sorted(groups.items()):
        for metric, direction, category in relative_checks:
            valid = [(row, row['_numbers'][metric]) for row in members if row['_numbers'][metric] is not None]
            values = [value for _, value in valid]
            entry = dict(group=group, metric=metric, n_valid=len(values), median='NA', q25='NA', q75='NA',
                         scaled_MAD='NA', scale_used='NA', lower_flag_bound='NA', upper_flag_bound='NA', status='')
            if not values:
                entry['status'] = 'unavailable'
                summaries.append(entry)
                continue
            median = statistics.median(values)
            q25, q75 = quantile(values, 0.25), quantile(values, 0.75)
            mad = statistics.median([abs(value - median) for value in values])
            scale = 1.4826 * mad
            entry.update(median=median, q25=q25, q75=q75, scaled_MAD=scale)
            if metric == 'heterozygosity_called_diploid_SNPs' and group in args.skip_het_groups:
                entry['status'] = 'heterozygosity_check_disabled'
            elif len(values) < args.min_group_n:
                entry['status'] = 'too_few_samples_for_relative_check'
            else:
                entry['scale_used'] = 'scaled_MAD'
                if scale == 0:
                    scale = (q75 - q25) / 1.349
                    entry['scale_used'] = 'IQR/1.349_fallback'
                if scale <= 0:
                    entry['status'] = 'zero_spread_relative_check_skipped'
                else:
                    lower = median - args.outlier_z * scale
                    upper = median + args.outlier_z * scale
                    entry.update(lower_flag_bound=lower if direction in ('low', 'both') else 'NA',
                                 upper_flag_bound=upper if direction in ('high', 'both') else 'NA', status='checked')
                    for row, value in valid:
                        if direction in ('low', 'both') and value < lower:
                            flag(row, category, f'Within-group low {metric}: {value:.4g} < {lower:.4g}')
                        if direction in ('high', 'both') and value > upper:
                            flag(row, category, f'Within-group high {metric}: {value:.4g} > {upper:.4g}')
            summaries.append(entry)

    output = Path(args.outdir)
    output.mkdir(parents=True, exist_ok=True)
    report = []
    for row in sorted(rows, key=lambda r: (r['group'], r['sample_id'])):
        categories = row['_categories']
        # Count distinct technical dimensions, not correlated warnings twice.
        technical = categories & {'missingness', 'depth', 'genotype_quality'}
        status = 'MULTIPLE_TECHNICAL_WARNINGS' if len(technical) >= 2 else 'REVIEW' if categories else 'INCOMPLETE_QC' if row['_missing'] else 'NO_FLAGS'
        result = {key: value for key, value in row.items() if not key.startswith('_')}
        result.update(status=status, n_flag_categories=len(categories), n_technical_dimensions=len(technical),
                      flag_categories=';'.join(sorted(categories)), flags=' | '.join(row['_flags']),
                      unavailable_metrics=';'.join(sorted(set(row['_missing']))))
        report.append(result)
    lead = ['group', 'sample_id', 'status', 'n_flag_categories', 'n_technical_dimensions', 'flag_categories', 'flags', 'unavailable_metrics']
    original_fields = sorted(set().union(*(set(r.keys()) for r in report)) - set(lead) - {'species'})
    write_table(output / 'all_samples_qc_review.tsv', lead + original_fields, report)
    write_table(output / 'samples_to_investigate.tsv', lead + original_fields, [r for r in report if r['status'] != 'NO_FLAGS'])
    summary_fields = ['group', 'metric', 'n_valid', 'median', 'q25', 'q75', 'scaled_MAD', 'scale_used', 'lower_flag_bound', 'upper_flag_bound', 'status']
    write_table(output / 'group_metric_summaries.tsv', summary_fields, summaries)

    by_sample = defaultdict(list)
    for row in report:
        by_sample[row['sample_id']].append(row)
    unique = []
    for sample, entries in sorted(by_sample.items()):
        reviewed = [entry for entry in entries if entry['status'] != 'NO_FLAGS']
        unique.append(dict(sample_id=sample, groups=';'.join(sorted(e['group'] for e in entries)),
                           n_groups=len(entries), review_groups=';'.join(sorted(e['group'] for e in reviewed)),
                           review_any_group='YES' if reviewed else 'NO',
                           flags_by_group=' | '.join(e['group'] + ': ' + (e['flags'] or 'Unavailable QC metrics') for e in reviewed)))
    write_table(output / 'unique_sample_review.tsv', ['sample_id', 'groups', 'n_groups', 'review_groups', 'review_any_group', 'flags_by_group'], unique)

    flagged = sum(r['status'] != 'NO_FLAGS' for r in report)
    notes = [
        f'Group/sample rows: {len(report)}; unique samples: {len(unique)}; rows requiring review: {flagged}.',
        'Flags are exploratory INVESTIGATION prompts, not validated failures or exclusion decisions.',
        'NO_FLAGS does not prove a sample is high quality. This script cannot detect all contamination, mapping, or sample identity issues.',
        'Absolute thresholds are configurable starting points and may be inappropriate for low-coverage designs.',
        'Relative outliers use within-group medians and 1.4826*MAD; IQR/1.349 is used only when MAD is zero.',
        'Small groups or zero-spread distributions do not receive relative outlier checks.',
        'Heterozygosity flags may be biological, especially in admixed, hybrid, or structured groups.',
        'MULTIPLE_TECHNICAL_WARNINGS means at least two of missingness, depth, and GQ are flagged; correlated flags are not independent evidence.',
        'Sample overlap between groups is retained explicitly, not counted as independent individuals.',
        'DP/GQ describe complete genotype calls with available values at the QC SNP records, not genome-wide coverage.',
        'Unfiltered calls can inflate heterozygosity or confidence summaries; reassess after justified genotype masking.',
        'No VCFs were modified and no exclusion list was generated.',
        'Outputs in the chosen directory are overwritten on rerun. Use a new directory to preserve earlier reports.',
        '', 'Parameters:',
    ]
    notes.extend(f'{key}: {value}' for key, value in sorted(vars(args).items()))
    (output / 'README_QC_report.txt').write_text('\n'.join(notes) + '\n')
    print(notes[0])
    print(f'Reports written to: {output.resolve()}')
    print('Start with samples_to_investigate.tsv and group_metric_summaries.tsv.')


if __name__ == '__main__':
    main()

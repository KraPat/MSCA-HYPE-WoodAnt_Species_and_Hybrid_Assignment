#Next, we use a script to mask GT and QC. Specifically, it keeps genotypes meeting both DP ≥ 8 and GQ ≥ 20 and sets genotypes tomissing with DP or GQ unabailable. After masking, it recalculates sample missingness before filtering sites, using the same SNP records as the original QC. This makes the before/after comparison meaningful.
###############################################################################
#!/bin/bash
#SBATCH --job-name=maskGT_QC
#SBATCH --account=project_2009316
#SBATCH --output=maskGT_QC_%A_%a.out
#SBATCH --error=maskGT_QC_%A_%a.err
#SBATCH --time=48:00:00
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16000M
#SBATCH --array=1-10%4

# Save as mask_genotypes_qc.sh and submit with: sbatch mask_genotypes_qc.sh
# Adjust account/partition/module/path settings for your cluster.
# Requires bcftools with the +setGT plugin and Python 3.
# Reads the ORIGINAL subset VCFs, not a previous masked VCF.
# Does not remove any samples or records; no site-level filters are applied.
# DP >= 8 AND GQ >= 20 are required; missing DP/GQ makes a GT unusable.
# Existing missing GT are not imputed or recovered.
# QC uses precisely the original script's definition of canonical biallelic SNPs.

set -euo pipefail
module load bio-apps/v202603
# Add your cluster's bcftools module here if necessary.

INDIR="/scratch/project_2009316/EuSamples/06.VCF/species_QC"
OUTDIR="/scratch/project_2009316/EuSamples/06.VCF/species_masked_QC"
MIN_DP=8
MIN_GQ=20
GROUPS_TO_PROCESS=(Admi1 aquiScand lugu poly prat aquiCentral aqui para polyXrufa rufa)

command -v bcftools >/dev/null || { echo 'ERROR: bcftools not available.' >&2; exit 1; }
command -v python3 >/dev/null || { echo 'ERROR: Python 3 not available.' >&2; exit 1; }
TASK_ID="${SLURM_ARRAY_TASK_ID:?Submit as a SLURM array}"
if (( TASK_ID < 1 || TASK_ID > ${#GROUPS_TO_PROCESS[@]} )); then
    echo 'ERROR: Task number outside group range.' >&2
    exit 1
fi
GROUP="${GROUPS_TO_PROCESS[$((TASK_ID - 1))]}"
VCF="$INDIR/$GROUP/$GROUP.subset.vcf.gz"
# Optional baseline QC generated by the original subsetting script.
BASELINE="$INDIR/$GROUP/$GROUP.sample_QC.tsv"
DEST="$OUTDIR/$GROUP"
FINAL="$DEST/$GROUP.DP${MIN_DP}.GQ${MIN_GQ}.masked.vcf.gz"
mkdir -p "$DEST"
[[ -r "$VCF" ]] || { echo "ERROR: Cannot read $VCF" >&2; exit 1; }
# Refuse to overwrite an existing result. Use another OUTDIR for a separate run.
[[ ! -e "$FINAL" && ! -e "$FINAL.csi" ]] || { echo "ERROR: Output already exists: $FINAL. Use a new OUTDIR or deliberately remove previous outputs." >&2; exit 1; }
WORK="$(mktemp -d "$DEST/.work.XXXXXX")"
trap 'echo "Failure; diagnostic/work files retained in $WORK" >&2' ERR
export VCF BASELINE WORK GROUP MIN_DP MIN_GQ

bcftools --version > "$WORK/bcftools_version.txt"
bcftools query -l "$VCF" > "$WORK/input_samples.txt"
bcftools view -h "$VCF" > "$WORK/input_header.txt"

python3 - <<'PY'
import os
import re
from pathlib import Path
w = Path(os.environ['WORK'])
header = (w / 'input_header.txt').read_text()
for tag in ('GT', 'DP', 'GQ'):
    if not re.search(r'^##FORMAT=<ID=' + tag + r'[,>]', header, re.M):
        raise SystemExit(f'ERROR: FORMAT/{tag} is absent from the header. This script stops rather than silently masking the entire dataset.')
samples = (w / 'input_samples.txt').read_text().splitlines()
if not samples or len(samples) != len(set(samples)):
    raise SystemExit('ERROR: Empty or duplicated input sample IDs.')
print(f"{os.environ['GROUP']}: {len(samples)} samples", flush=True)
PY

# IMPORTANT: single | operators combine criteria at the SAME SAMPLE level.
# Do not substitute || here: that has site-level semantics in bcftools.
# -t q selects GT using the expression; -n . sets selected GT to missing.
# Missing values in DP/GQ are explicitly included.
MASK_EXPR="FMT/DP=\".\" | FMT/GQ=\".\" | FMT/DP<${MIN_DP} | FMT/GQ<${MIN_GQ}"
bcftools +setGT "$VCF" -Oz -o "$WORK/masked.vcf.gz" -- -t q -n . -i "$MASK_EXPR"
bcftools index -f "$WORK/masked.vcf.gz"
bcftools query -l "$WORK/masked.vcf.gz" > "$WORK/output_samples.txt"

# Stream original and masked records together. This verifies that no records
# were lost/reordered and that masking acted on each sample as intended.
# Only per-sample counters are stored in memory, not the genotype matrix.
python3 - <<'PY'
import os
import re
import csv
import math
import subprocess
from itertools import zip_longest
from pathlib import Path

w = Path(os.environ['WORK'])
group = os.environ['GROUP']
min_dp = float(os.environ['MIN_DP'])
min_gq = float(os.environ['MIN_GQ'])
samples = (w / 'input_samples.txt').read_text().splitlines()
if samples != (w / 'output_samples.txt').read_text().splitlines():
    raise SystemExit('ERROR: Sample IDs/order changed after masking.')
counts = [dict(n=0, before_called=0, after_called=0, before_partial=0,
               after_partial=0, newly_missing=0, absent_tag=0,
               low_dp=0, low_gq=0) for _ in samples]


def numeric(value):
    try:
        x = float(value)
        return x if math.isfinite(x) else None
    except ValueError:
        return None


def gt_state(gt):
    alleles = re.split(r'[/|]', gt)
    n_missing = sum(allele == '.' for allele in alleles)
    return n_missing == 0, 0 < n_missing < len(alleles)


before = subprocess.Popen(['bcftools', 'query', '-f', '%CHROM\t%POS\t%REF\t%ALT[\t%GT\t%DP\t%GQ]\n', os.environ['VCF']], stdout=subprocess.PIPE, text=True)
after = subprocess.Popen(['bcftools', 'query', '-f', '%CHROM\t%POS\t%REF\t%ALT[\t%GT]\n', str(w / 'masked.vcf.gz')], stdout=subprocess.PIPE, text=True)
n_records = 0
try:
    for original_line, masked_line in zip_longest(before.stdout, after.stdout):
        if original_line is None or masked_line is None:
            raise RuntimeError('Input/output record counts differ.')
        original = original_line.rstrip('\n').split('\t')
        masked = masked_line.rstrip('\n').split('\t')
        if len(original) != 4 + 3 * len(samples) or len(masked) != 4 + len(samples):
            raise RuntimeError('Unexpected query field count.')
        if original[:4] != masked[:4]:
            raise RuntimeError('Record identities/order changed during masking.')
        n_records += 1
        ref, alt = original[2], original[3]
        # EXACTLY the same SNP definition as the original QC-generation script.
        is_qc_snp = len(ref) == 1 and len(alt) == 1 and ref.upper() in 'ACGT' and alt.upper() in 'ACGT'
        for i, c in enumerate(counts):
            offset = 4 + 3 * i
            old_gt = original[offset]
            new_gt = masked[4 + i]
            dp = numeric(original[offset + 1])
            gq = numeric(original[offset + 2])
            usable = dp is not None and gq is not None and dp >= min_dp and gq >= min_gq
            old_complete, old_partial = gt_state(old_gt)
            new_complete, new_partial = gt_state(new_gt)
            # Validate masking for ALL record types, not only QC SNPs.
            if usable:
                if new_gt != old_gt:
                    raise RuntimeError(f'Passing GT changed: {samples[i]} at {original[0]}:{original[1]}')
            else:
                new_alleles = re.split(r'[/|]', new_gt)
                if any(allele != '.' for allele in new_alleles):
                    raise RuntimeError(f'Failing GT was not fully masked: {samples[i]} at {original[0]}:{original[1]}')
            if not is_qc_snp:
                continue
            c['n'] += 1
            c['before_called'] += int(old_complete)
            c['after_called'] += int(new_complete)
            c['before_partial'] += int(old_partial)
            c['after_partial'] += int(new_partial)
            if old_complete:
                c['newly_missing'] += int(not new_complete)
                c['absent_tag'] += int(dp is None or gq is None)
                c['low_dp'] += int(dp is not None and dp < min_dp)
                c['low_gq'] += int(gq is not None and gq < min_gq)
    rc_before, rc_after = before.wait(), after.wait()
    if rc_before != 0 or rc_after != 0:
        raise RuntimeError(f'bcftools query failed: original={rc_before}, masked={rc_after}')
except Exception:
    for proc in (before, after):
        if proc.poll() is None:
            proc.kill()
        proc.wait()
    raise
if counts[0]['n'] == 0:
    raise SystemExit('ERROR: No canonical biallelic SNP records for QC.')

# Confirm counts agree with original QC, when its table is available.
# This checks the record denominator and complete-GT counts, not rounded fractions.
baseline = Path(os.environ['BASELINE'])
if baseline.is_file():
    with baseline.open(newline='') as handle:
        previous = {row['sample_id']: row for row in csv.DictReader(handle, delimiter='\t')}
    if set(previous) != set(samples):
        raise SystemExit('ERROR: Original QC sample IDs do not match the input VCF.')
    for sample, c in zip(samples, counts):
        old = previous[sample]
        if int(old['n_biallelic_snp_records']) != c['n'] or int(old['n_complete_GT']) != c['before_called']:
            raise SystemExit(f'ERROR: Original QC denominator/called count mismatch for {sample}. Check that VCF and QC table belong to the same run.')
    baseline_status = 'Original QC denominator and complete-GT counts verified.'
else:
    baseline_status = 'Original QC table absent; before/after records matched directly, but previous QC table could not be verified.'


def ratio(a, b):
    return round(a / b, 6) if b else 'NA'


columns = ['group', 'sample_id', 'n_biallelic_snp_records', 'n_complete_GT_before',
           'n_complete_GT_after', 'n_missing_GT_before', 'n_missing_GT_after',
           'missing_GT_fraction_before', 'missing_GT_fraction_after',
           'increase_missingness_percentage_points', 'n_newly_missing_complete_GT',
           'fraction_original_complete_GT_masked', 'n_partial_missing_GT_before',
           'n_partial_missing_GT_after', 'n_original_complete_GT_missing_DP_or_GQ',
           'n_original_complete_GT_DP_below_threshold', 'n_original_complete_GT_GQ_below_threshold',
           'postmask_missingness_above_50pct']
with (w / 'missingness_before_after.tsv').open('w', newline='') as handle:
    writer = csv.writer(handle, delimiter='\t')
    writer.writerow(columns)
    for sample, c in zip(samples, counts):
        n = c['n']
        missing_before = n - c['before_called']
        missing_after = n - c['after_called']
        writer.writerow([group, sample, n, c['before_called'], c['after_called'],
                         missing_before, missing_after, ratio(missing_before, n),
                         ratio(missing_after, n), round(100 * (missing_after - missing_before) / n, 4),
                         c['newly_missing'], ratio(c['newly_missing'], c['before_called']),
                         c['before_partial'], c['after_partial'], c['absent_tag'],
                         c['low_dp'], c['low_gq'], 'YES' if missing_after / n > 0.5 else 'NO'])
notes = [
    f'Group: {group}', f'Minimum DP: {min_dp:g}', f'Minimum GQ: {min_gq:g}',
    f'Total VCF records checked: {n_records}', f'QC SNP records: {counts[0]["n"]}', baseline_status,
    'No samples or records were removed. No site-level filtering was applied.',
    'All input/output record identities and sample order were verified.',
    'Masking was checked for every genotype across all record types.',
    'QC denominator: original canonical biallelic SNP records, including sites monomorphic within a group.',
    'Partial-missing GT count as missing; passing partial GT remain partial.',
    'Thresholds apply to individual genotype DP/GQ, not mean sample DP/GQ.',
    'Reason counts may overlap: one GT can have low DP and low GQ.',
    'postmask_missingness_above_50pct is a descriptive warning, NOT an exclusion decision.',
    'No allele counts/frequencies were refreshed. Existing INFO/AC, AN, AF and other cohort summaries may be stale after masking.',
    'Recalculate INFO tags from retained GT before later allele-count/frequency filtering.',
    'DP/GQ and other FORMAT fields are retained even for masked GT; downstream tools must honor missing GT.',
]
(w / 'masking_notes.txt').write_text('\n'.join(notes) + '\n')
print('\n'.join(notes[:6]), flush=True)
print(f'Samples above 50% postmask missingness: {sum((c["n"] - c["after_called"]) / c["n"] > 0.5 for c in counts)}', flush=True)
PY

PREFIX="$GROUP.DP${MIN_DP}.GQ${MIN_GQ}"
cp "$WORK/missingness_before_after.tsv" "$DEST/$PREFIX.missingness_before_after.tsv"
cp "$WORK/masking_notes.txt" "$DEST/$PREFIX.masking_notes.txt"
cp "$WORK/output_samples.txt" "$DEST/$PREFIX.samples.txt"
cp "$WORK/bcftools_version.txt" "$DEST/$PREFIX.bcftools_version.txt"
mv "$WORK/masked.vcf.gz" "$FINAL"
mv "$WORK/masked.vcf.gz.csi" "$FINAL.csi"
rm -rf -- "$WORK"
trap - ERR
printf 'COMPLETE: %s\nMasked VCF: %s\nComparison: %s/%s.missingness_before_after.tsv\n' "$GROUP" "$FINAL" "$DEST" "$PREFIX"


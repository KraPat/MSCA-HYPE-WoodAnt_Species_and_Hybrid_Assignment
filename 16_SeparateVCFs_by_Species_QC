if proc.wait() != 0:
    raise SystemExit('ERROR: bcftools genotype query failed.')
if not metrics or metrics[0]['n'] == 0:
    raise SystemExit('ERROR: No canonical biallelic SNP records found for QC.')


def ratio(a, b):
    return round(a / b, 6) if b else 'NA'

columns = ['species', 'sample_id', 'n_biallelic_snp_records', 'n_complete_GT',
           'n_partial_missing_GT', 'n_fully_missing_GT', 'missing_GT_fraction',
           'n_complete_diploid_GT', 'n_heterozygous_GT', 'heterozygosity_called_diploid_SNPs',
           'n_called_GT_with_DP', 'mean_DP_called_GT', 'fraction_DP_lt5', 'fraction_DP_lt10',
           'n_called_GT_with_GQ', 'mean_GQ_called_GT', 'fraction_GQ_lt20', 'fraction_GQ_lt30']
with (w / 'sample_QC.tsv').open('w', newline='') as handle:
    writer = csv.writer(handle, delimiter='\t')
    writer.writerow(columns)
    for sample, m in zip(samples, metrics):
        writer.writerow([species, sample, m['n'], m['complete'], m['partial'], m['absent'],
                         ratio(m['partial'] + m['absent'], m['n']), m['diploid'], m['het'],
                         ratio(m['het'], m['diploid']), m['dp_n'], ratio(m['dp_sum'], m['dp_n']),
                         ratio(m['dp_lt5'], m['dp_n']), ratio(m['dp_lt10'], m['dp_n']),
                         m['gq_n'], ratio(m['gq_sum'], m['gq_n']),
                         ratio(m['gq_lt20'], m['gq_n']), ratio(m['gq_lt30'], m['gq_n'])])
(w / 'QC_notes.txt').write_text(
    f'FORMAT/DP present: {has_dp}\nFORMAT/GQ present: {has_gq}\n'
    'QC uses input canonical biallelic SNP records, including within-species monomorphic sites.\n'
    'Partial-missing genotypes count as missing. DP/GQ summaries use complete GT only and available tag values.\n'
    'Heterozygosity denominator is complete diploid GT; it is NOT nucleotide diversity.\n'
    'Depth at variant records is NOT genome-wide BAM coverage.\n'
    'DP/GQ cutoffs are descriptive diagnostics, not automatic exclusion criteria.\n'
    'Variant-only missingness is affected by ascertainment; use BAM QC for broader coverage assessment.\n'
    'No samples, sites, or genotypes have been filtered by this script.\n')
print(f'QC complete: {len(samples)} samples; {metrics[0]["n"]} biallelic SNP records.', flush=True)
PY

# These outputs replace prior outputs for this species if rerun.
mv -f "$WORK/subset.vcf.gz" "$DEST/$SPECIES.subset.vcf.gz"
mv -f "$WORK/subset.vcf.gz.csi" "$DEST/$SPECIES.subset.vcf.gz.csi"

#!/bin/bash -l
#SBATCH -J pixy_100kb_highCov
#SBATCH -o /scratch/project_2009316/EuSamples/06.VCF/pixy/logs/pixy_100kb_highcov_%j.out
#SBATCH -e /scratch/project_2009316/EuSamples/06.VCF/pixy/logs/pixy_100kb_highcov_%j.err
#SBATCH --account=project_2009316
#SBATCH -t 40:00:00
#SBATCH -p small
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=4G

set -euo pipefail
module load bio-apps/v202603
module load samtools/1.21
export PATH="/projappl/project_2009316/pixyEnv/bin:$PATH"

cd /scratch/project_2009316/EuSamples/06.VCF/pixy/

BASEDIR=/scratch/project_2009316/EuSamples/06.VCF/pixy
OUTDIR=$BASEDIR/pi_dxy_fst
VCF=/scratch/project_2009316/EuSamples/06.VCF/gvcf/highCovSamples_filtered_noindels_rmdup.vcf.gz
POPS_ALL=/scratch/project_2009316/EuSamples/06.VCF/filt/samples_ALL.txt
POPS_SCAND_CENTRAL=/scratch/project_2009316/EuSamples/06.VCF/filt/samples_ALL_ScandCentral.txt

cd "$BASEDIR"

[[ -s "$VCF" ]] || { echo "Missing VCF: $VCF" >&2; exit 1; }
[[ -s "${VCF}.tbi" || -s "${VCF}.csi" ]] || { echo "VCF index not found" >&2; exit 1; }
[[ -s "$POPS_ALL" ]] || { echo "Missing populations file: $POPS_ALL" >&2; exit 1; }
[[ -s "$POPS_SCAND_CENTRAL" ]] || { echo "Missing populations file: $POPS_SCAND_CENTRAL" >&2; exit 1; }

echo "Running Pixy with aqui combined ..."
pixy --stats pi dxy fst \
    --vcf "$VCF" \
    --populations "$POPS_ALL" \
    --window_size 100000 \
    --output_folder "$OUTDIR/combined_aqui"  \
    --output_prefix "pixy_100kb_highCov_allSamples"
    --n_cores "$SLURM_CPUS_PER_TASK"

echo "Running Pixy with aqui split into Scand and Central ..."
pixy --stats pi dxy fst \
    --vcf "$VCF" \
    --populations "$POPS_SCAND_CENTRAL" \
    --window_size 100000 \
    --output_folder "$OUTDIR/aqui_subpopulations"  \
    --output_prefix "pixy_100kb_highCov_ScandCentral"
    --n_cores "$SLURM_CPUS_PER_TASK"

#END.

#get the results for plotting
scp krapfpat@puhti.csc.fi:'/scratch/project_2009316/EuSamples/06.VCF/pixy/pixy_50kb_highcov*.txt' ./




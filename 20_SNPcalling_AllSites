#!/bin/bash -l
#SBATCH -J remove_duplicates
#SBATCH -o /scratch/project_2009316/EuSamples/06.VCF/gvcf/logs/remove_duplicates.out
#SBATCH -e /scratch/project_2009316/EuSamples/06.VCF/gvcf/logs/remove_duplicates.err
#SBATCH --account=project_2009316
#SBATCH -t 24:00:00
#SBATCH -p small
#SBATCH --ntasks 1
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G

module load bio-apps/v202603
module load bcftools

cd /scratch/project_2009316/EuSamples/06.VCF/gvcf

VCFIN=/scratch/project_2009316/EuSamples/06.VCF/gvcf/filtered.vcf.gz

echo "Counting the initial number of records in filtered.vcf.gz ..."
bcftools index -n $VCFIN

#Filter out duplicate sites (achieve this by filtering out all that are mnp's and not homozygous "ref" or "snp" type)
echo "counting the amount of duplicates in filtered.vcf.gz (divide this number by two)..."
echo $VCFIN
gunzip -c $VCFIN | cut -f2 | uniq -D | wc -l

#Keep only sites hom for reference allele or snps
bcftools filter --threads 8 -Oz -e 'TYPE!="ref" && TYPE!="snp"' -m+ $VCFIN > filtered_noindels.vcf.gz
bcftools index -t filtered_noindels.vcf.gz

echo "Counting how many sites remain after TYPEref and TYPEsnp filtering..."
bcftools index -n filtered_noindels.vcf.gz

echo "Counting how many duplicates are left (divide the number by two)..."
gunzip -c filtered_noindels.vcf.gz | cut -f2 | uniq -D | wc -l

echo "Checking duplicate positions on chromosome_1 - specifically checking examples of what kind of variants they are - mnps? look at these coordinates in the filtered_noindels.vcf.gz file..."
gunzip -c filtered_noindels.vcf.gz | grep "chromosome_1" | cut -f2 | uniq -D | head     # e.g. xx, yy, zz
#bcftools view -H -r chromosome1:5047119 filtered_noindels.vcf.gz #They are mnps

#Always the first one is the snp and the second one mnp. Remove all second instances
echo "Removing exact duplicate records - all second instances of duplicate sites (expecting the first ones to be the real snps)..."
bcftools norm --rm-dup all --threads 8 -Oz filtered_noindels.vcf.gz > filtered_noindels_rmdup.vcf.gz
bcftools index -t filtered_noindels_rmdup.vcf.gz

echo "Counting records after duplicate filtering (add to this the initial #of duplicates - does it match with the input vcf site count?) ..."
bcftools index -n filtered_noindels_rmdup.vcf.gz 

echo "Counting how many duplicates remain (divide by two)..."
gunzip -c filtered_noindels_rmdup.vcf.gz | cut -f2 | uniq -D | wc -l


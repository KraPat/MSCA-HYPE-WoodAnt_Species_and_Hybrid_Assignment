#!/bin/bash -l
#SBATCH -J concat_filtered_vcfs
#SBATCH -o /scratch/project_2009316/EuSamples/06.VCF/gvcf/logs/concat_filtered_vcfs_%j.out
#SBATCH -e /scratch/project_2009316/EuSamples/06.VCF/gvcf/logs/concat_filtered_vcfs_%j.err
#SBATCH --account=project_2009316
#SBATCH -t 48:00:00
#SBATCH -p small
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G

set -euo pipefail

module load bio-apps/v202603
module load bcftools

cd /scratch/project_2009316/EuSamples/06.VCF/gvcf/raw/

CHROMS=/scratch/project_2009316/rufaRefGenome/chromosomes_no03_no23.list

while IFS= read -r chrom; do
    file="${chrom}_filtered.vcf.gz"
    if [[ ! -s "$file" ]]; then
        echo "Missing or empty input: $file" >&2
        exit 1
    fi
    printf '%s\n' "$file"
done < "$CHROMS" > filtered_vcfs.list

bcftools concat --allow-overlaps --threads 3 -f filtered_vcfs.list -Oz -o ../filtered.vcf.gz
bcftools index -t ../filtered.vcf.gz


#!/bin/bash -l
#SBATCH -J SortnIndexVCF
#SBATCH -o /scratch/project_2009316/EuSamples/06.VCF/logs/SortIndex_VCF_%j.out
#SBATCH -e /scratch/project_2009316/EuSamples/06.VCF/logs/SortIndex_VCF_%j.err
#SBATCH --account=project_2009316
#SBATCH --time=48:00:00
#SBATCH -p small
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --mail-type=START,FAIL,END

set -euo pipefail

module load bio-apps/v202603
module load bcftools

INPUT=/scratch/project_2009316/EuSamples/06.VCF/raw/DutchWoodAnts_20261027_raw.vcf.gz
OUTDIR=/scratch/project_2009316/EuSamples/06.VCF/raw
PREFIX=DutchWoodAnts_20261027_raw.sorted

mkdir -p "$OUTDIR"

OUTPUT="$OUTDIR/${PREFIX}.vcf.gz"
COUNTS="$OUTDIR/${PREFIX}.chromosome_record_counts.tsv"
THREADS=${SLURM_CPUS_PER_TASK:-4}

# Separate run summary and error files.
exec > "$OUTDIR/${PREFIX}.run_summary.txt" 2> "$OUTDIR/${PREFIX}.run_errors.txt"

[[ -r "$INPUT" ]] || { echo "ERROR: Cannot read input: $INPUT" >&2; exit 1; }
[[ "$INPUT" != "$OUTPUT" ]] || { echo 'ERROR: Input and output paths must differ.' >&2; exit 1; }

# Unique temporary directory; removed on completion or failure.
SORT_TMP=$(mktemp -d "$OUTDIR/tmp_sort_${SLURM_JOB_ID:-local}_XXXXXX")
trap 'rm -rf -- "$SORT_TMP"' EXIT

printf 'Started: %s\nInput: %s\nOutput: %s\n' "$(date -Is)" "$INPUT" "$OUTPUT"
echo 'WARNING: Existing output files with this prefix will be overwritten.'

# 1. Sort by chromosome and position and write a BGZF-compressed VCF.
# -m limits the approximate sorting buffer, not total process memory.
# Remove old indexes so they cannot be mistaken for indexes of the new file.
rm -f -- "${OUTPUT}.csi" "${OUTPUT}.tbi"
bcftools sort -m 8G -T "$SORT_TMP/sort" -Oz -o "$OUTPUT" "$INPUT" 2> "$OUTDIR/${PREFIX}.sorting.log"
echo 'Sorting completed.'

# 2. Create a CSI index for the compressed VCF.
# With set -e, this runs only if sorting succeeded.
bcftools index --threads "$THREADS" --csi "$OUTPUT" 2> "$OUTDIR/${PREFIX}.indexing.log"
echo 'Indexing completed.'

# 3. Get chromosome name, chromosome length, and record count from the index.
# Counts are VCF records, not necessarily unique positions or SNPs.
printf 'CHROM\tLENGTH\tN_RECORDS\n' > "$COUNTS"
bcftools index --stats "$OUTPUT" >> "$COUNTS" 2> "$OUTDIR/${PREFIX}.chromosome_counts.log"

echo "Chromosome record counts saved to: $COUNTS"
printf 'Finished successfully: %s\n' "$(date -Is)"
#END



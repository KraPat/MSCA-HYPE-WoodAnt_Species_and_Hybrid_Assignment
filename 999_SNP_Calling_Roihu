# FreeBayes analysis jobs can be computationally heavy and should be run as batch jobs on Roihu. Below is a sample batch job script:
#############################################################################################
#!/bin/bash
#SBATCH --job-name=freebayes
#SBATCH --account=project_2009316
#SBATCH --output=output_%j.txt
#SBATCH --error=errors_%j.txt
#SBATCH --time=72:00:00
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=16000M

module load bio-apps/v202603
module load freebayes/1.3.6
module load samtools

cd /scratch/project_2009316/EuSamples/06.VCF
REF=/scratch/project_2009316/rufaRefGenome
RES=/scratch/project_2009316/EuSamples/06.VCF/raw
BAM=/scratch/project_2009316/EuSamples/05.BAM/BAM_final
BAMLIST=/scratch/project_2009316/EuSamples/05.BAM/BAM_final/BAMlist

 
freebayes -regions $REF/Frufa_PR_May2026_v1_2e6_data_regions.txt \
  -f $REF/Frufa_PR_May2026.fa \
  -L $BAM/DutchBAMlist \
  -k --genotype-qualities --skip-coverage 57750 \
  --limit-coverage 80 \ 
  --use-best-n-alleles 3 \
  --ploidy 2 \
  --min-mapping-quality 20 \
  --min-base-quality 20 \
  --max-complex-gap -1 \
  --haplotype-length -1 \
  -out $RES/DutchWoodAnts_102026_raw.vcf

echo "SNP CALLING GONE"
# DONE

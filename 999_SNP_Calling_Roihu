#################################################################################################################################

!/bin/bash -l
#SBATCH -J VCF_file
#SBATCH -o /scratch/project_2009316/EuSamples/06.VCF/logs/cp_BCF_%A_%a.out
#SBATCH -e /scratch/project_2009316/EuSamples/06.VCF/logs/cp_BCF_%A_%a.err
#SBATCH --account=project_2009316
#SBATCH -t 48:00:00
#SBATCH -p small
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --mail-type=START,FAIL,END

# Load bcftools (adjust to your cluster's module/env system)
module load biokit

ORIGINAL_VCF=/scratch/project_2009316/EuSamples/06.VCF/raw/all_samples_raw.vcf
BACKUP_VCF=/scratch/project_2009316/EuSamples/06.VCF/raw/all_samples_raw.backup.vcf
FIXED_BCF=/scratch/project_2009316/EuSamples/06.VCF/raw/all_samples_raw.fixed.bcf

# Malformed site to remove (EDIT chr/pos if needed)
CHR="chromosome_11"
POS="11604477"

echo "Original VCF: $ORIGINAL_VCF"
echo "Backup VCF  : $BACKUP_VCF"
echo "Fixed BCF   : $FIXED_BCF"
echo "Removing site: $CHR:$POS"

# 1. Make a backup copy of the original VCF (if not already present)
#if [ ! -f "$BACKUP_VCF" ]; then
#       echo "Creating backup VCF at $BACKUP_VCF"
#       cp "$ORIGINAL_VCF" "$BACKUP_VCF"
#else
#       echo "Backup VCF already exists at $BACKUP_VCF; not overwriting."
#fi

# 2. Filter out the malformed record and convert directly to BCF
#    - awk keeps all header lines (#...)
#    - for data lines, it drops the one with CHROM==CHR and POS==POS
#    - bcftools view reads VCF from stdin (-) and writes BCF

echo "Filtering out $CHR:$POS and writing BCF..."

awk -v chr="$CHR" -v pos="$POS" '
BEGIN { FS = OFS = "\t" }
# Keep all header lines as-is
/^#/ { print; next }
# For data lines, skip the malformed site; print everything else
{
        if (!($1 == chr && $2 == pos)) {
                print
        }
}
' "$ORIGINAL_VCF" \
       | bcftools view -Ob -o "$FIXED_BCF" -



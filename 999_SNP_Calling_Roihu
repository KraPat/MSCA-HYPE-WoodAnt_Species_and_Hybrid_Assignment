#################################################################################################################################
#!/bin/bash -l
#SBATCH -J vcf_sanity
#SBATCH -o /scratch/project_2009316/EuSamples/06.VCF/logs/VCFsanit_%j.out
#SBATCH -e /scratch/project_2009316/EuSamples/06.VCF/logs/VCFsanit_%j.err
#SBATCH --account=project_2009316
#SBATCH --time=24:00:00
#SBATCH -p small
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --mail-type=START,FAIL,END

set -uo pipefail

VCF=/scratch/project_2009316/EuSamples/06.VCF/raw/DutchWoodAnts_20261027_raw.vcf.gz
REF=/scratch/project_2009316/rufaRefGenome/Frufa_PR_May2026.fa
OUTDIR=/scratch/project_2009316/EuSamples/06.VCF/sanity_checks/DutchWoodAnts_20261027_raw

mkdir -p "$OUTDIR" || exit 1
# Fixed filenames: rerunning this script overwrites the previous reports.
exec > "$OUTDIR/run_summary.txt" 2> "$OUTDIR/run_errors.txt"

printf 'VCF: %s\nReference: %s\nOutput directory: %s\nStarted: %s\n' "$VCF" "$REF" "$OUTDIR" "$(date -Is)"

module load bio-apps/v202603 || exit 1
module load bcftools || exit 1

[[ -r "$VCF" ]] || { echo "ERROR: Cannot read VCF: $VCF" >&2; exit 1; }
[[ -r "$REF" ]] || { echo "ERROR: Cannot read reference: $REF" >&2; exit 1; }

printf 'check\texit_status\n' > "$OUTDIR/check_exit_status.tsv"
FAILED=0

# 1. Extract sample IDs and count them.
# Stop if the header cannot be read: the column-count check needs this count.
bcftools query -l "$VCF" > "$OUTDIR/sample_names.txt" 2> "$OUTDIR/sample_header_errors.txt"
STATUS=$?
printf 'sample_header\t%s\n' "$STATUS" >> "$OUTDIR/check_exit_status.tsv"
if (( STATUS != 0 )); then
    echo 'ERROR: Could not read sample names. See sample_header_errors.txt.' >&2
    exit 1
fi
NSAMP=$(awk 'END { print NR + 0 }' "$OUTDIR/sample_names.txt")
printf '%s\n' "$NSAMP" > "$OUTDIR/sample_count.txt"
printf 'Number of samples: %s (expected for this dataset: 55)\n' "$NSAMP"
if (( NSAMP != 55 )); then
    echo 'WARNING: Sample count differs from the expected 55.'
fi

# 2–4. Scan the decompressed text once, without requiring a VCF index.
# This detects wrong column counts, counts records per chromosome, and
# checks nondecreasing positions and contiguous chromosome blocks.
# It does not check chromosome order against the header/reference.
for REPORT in chromosome_names.txt chromosome_record_counts.tsv malformed_records.txt coordinate_order_errors.txt text_scan_summary.txt; do
    : > "$OUTDIR/$REPORT"
done

# With pipefail, a decompression or AWK failure makes this check fail.
gzip -cd -- "$VCF" 2> "$OUTDIR/decompression_errors.txt" | awk -v nsamp="$NSAMP" -v out="$OUTDIR" '
BEGIN {
    FS = "\t"
    OFS = "\t"
    expected = (nsamp > 0 ? 9 + nsamp : 8)
}
!/^#/ {
    records++
    chrom = $1
    pos = $2
    counts[chrom]++

    if (NF != expected) {
        print "LINE", NR, "CHROM", chrom, "POS", pos, "NF", NF, "EXPECTED", expected > (out "/malformed_records.txt")
        malformed++
    }

    if (NF < 2 || chrom == "" || pos !~ /^[0-9]+$/ || pos + 0 < 1) {
        print "LINE", NR, "INVALID_CHROM_OR_POS", chrom, pos > (out "/coordinate_order_errors.txt")
        order_errors++
        next
    }

    if (!have_previous || chrom != previous_chrom) {
        if (seen[chrom]) {
            print "LINE", NR, "CHROM", chrom, "POS", pos, "CHROMOSOME_BLOCK_REPEATED" > (out "/coordinate_order_errors.txt")
            order_errors++
        }
        seen[chrom] = 1
    } else if (pos + 0 < previous_pos) {
        print "LINE", NR, "CHROM", chrom, "POS", pos, "PREVIOUS_POS", previous_pos, "POSITION_DECREASED" > (out "/coordinate_order_errors.txt")
        order_errors++
    }
    previous_chrom = chrom
    previous_pos = pos + 0
    have_previous = 1
}
END {
    for (chrom in counts) {
        print chrom > (out "/chromosome_names.txt")
        print chrom, counts[chrom] > (out "/chromosome_record_counts.tsv")
    }
    print "total_records", records + 0 > (out "/text_scan_summary.txt")
    print "wrong_column_count_records", malformed + 0 > (out "/text_scan_summary.txt")
    print "coordinate_order_errors", order_errors + 0 > (out "/text_scan_summary.txt")
}
' 2> "$OUTDIR/text_scan_errors.txt"
STATUS=$?
printf 'text_scan\t%s\n' "$STATUS" >> "$OUTDIR/check_exit_status.tsv"
if (( STATUS != 0 )); then
    FAILED=1
    echo 'ERROR: Text scan failed; its reports may be incomplete.'
fi

# Stable alphabetical ordering of the chromosome reports.
sort -o "$OUTDIR/chromosome_names.txt" "$OUTDIR/chromosome_names.txt" || exit 1
sort -k1,1 -o "$OUTDIR/chromosome_record_counts.tsv" "$OUTDIR/chromosome_record_counts.tsv" || exit 1

# 5. Reference allele checks / normalization diagnostics.
# -c w warns about REF mismatches. Normalized output is discarded:
# the input VCF is not modified. This is not a comprehensive validator.
bcftools norm -c w -f "$REF" -Ou "$VCF" > /dev/null 2> "$OUTDIR/reference_check_diagnostics.txt"
STATUS=$?
printf 'reference_check\t%s\n' "$STATUS" >> "$OUTDIR/check_exit_status.tsv"
if (( STATUS != 0 )); then
    FAILED=1
    echo 'ERROR: Reference check failed. See reference_check_diagnostics.txt.'
fi

# 6. Summary statistics.
bcftools stats "$VCF" > "$OUTDIR/vcf_statistics.txt" 2> "$OUTDIR/vcf_statistics_errors.txt"
STATUS=$?
printf 'vcf_statistics\t%s\n' "$STATUS" >> "$OUTDIR/check_exit_status.tsv"
if (( STATUS != 0 )); then
    FAILED=1
    echo 'ERROR: Statistics command failed; its output may be incomplete.'
fi

printf '\nText-scan results (check text_scan exit status before interpreting):\n'
cat "$OUTDIR/text_scan_summary.txt"
printf '\nFinished: %s\n' "$(date -Is)"
echo 'Empty malformed_records.txt means no wrong column counts were found, provided the scan completed successfully.'
echo 'Empty coordinate_order_errors.txt means no coordinate/block errors were found, provided the scan completed successfully.'
echo 'Reference diagnostics may contain normal bcftools summary messages as well as warnings.'
echo 'Detected data issues are reported in the files; nonzero script exit means a check could not run successfully.'
exit "$FAILED"

#END
#################################################################################################################################

#Main output files
#Filename	Contents
#malformed_records.txt	Records with an incorrect number of columns
#chromosome_names.txt	Unique chromosome names
#chromosome_record_counts.tsv	Number of variant records per chromosome, excluding headers
#coordinate_order_errors.txt	Decreasing positions or chromosomes appearing in separate blocks
#reference_check_diagnostics.txt	REF-mismatch warnings and other bcftools norm diagnostics
#vcf_statistics.txt	Output from bcftools stats
#sample_names.txt	Sample IDs
#sample_count.txt	Number of samples
#check_exit_status.tsv	Whether each check completed successfully
#run_summary.txt	Overall run summary


#!/bin/bash
#SBATCH --job-name=freebayesDutch
#SBATCH --account=project_2009316
#SBATCH --output=output_%j.txt
#SBATCH --error=errors_%j.txt
#SBATCH --time=60:00:00
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=64G
#SBATCH --mail-type=BEGIN,END,FAIL

set -euo pipefail

module load bio-apps/v202603
module load freebayes/1.3.6

cd "/scratch/project_2009316/EuSamples/06.VCF"
REF=/scratch/project_2009316/rufaRefGenome
RES=/scratch/project_2009316/EuSamples/06.VCF/raw
BAM=/scratch/project_2009316/EuSamples/05.BAM/BAM_final

FASTA="$REF/Frufa_PR_May2026.fa"
REGIONS="$REF/Frufa_PR_May2026_v1_2e6_data_regions.txt"
BAMLIST="$BAM/DutchBAMlist"

mkdir -p "$RES"
JOB_ID="${SLURM_JOB_ID:-manual_$$}"
BED="$RES/Frufa_PR_May2026_v1_2e6_data_regions.${JOB_ID}.bed"
OUT="$RES/DutchWoodAnts_20261023_raw.vcf"
PARTIAL="${OUT}.partial.${JOB_ID}"

# Coordinate assumption: the text file contains zero-based, half-open
# contig:start-end intervals, as generated by fasta_generate_regions.py.
# For ONE-BASED INCLUSIVE input instead, set REGION_COORDS=one-based.
REGION_COORDS=zero-based

for FILE in "$FASTA" "$FASTA.fai" "$REGIONS" "$BAMLIST"; do
    if [[ ! -s "$FILE" ]]; then
        echo "ERROR: Required file is missing or empty: $FILE" >&2
        exit 1
    fi
done

# Protect any existing callset, including an old incomplete VCF.
# Rename or remove the old VCF deliberately before submitting this job.
if [[ -e "$OUT" ]]; then
    echo "ERROR: Output already exists: $OUT" >&2
    echo "Rename or remove it before resubmitting; it may be from the failed job." >&2
    exit 1
fi

# Convert contig:start-end notation to a tab-separated BED file.
# Ignore blank lines and comments; reject malformed or invalid intervals.
awk -v coords="$REGION_COORDS" 'BEGIN {OFS="\t"} {sub(/\r$/, ""); if ($0 ~ /^[[:space:]]*$/ || $0 ~ /^[[:space:]]*#/) next; if (split($0, a, ":") != 2 || a[1] == "" || split(a[2], b, "-") != 2 || b[1] !~ /^[0-9]+$/ || b[2] !~ /^[0-9]+$/) {print "ERROR: Malformed region at line " NR > "/dev/stderr"; exit 1} start=b[1]+0; end=b[2]+0; if (coords == "one-based") start--; if (start < 0 || end <= start) {print "ERROR: Invalid coordinates at line " NR > "/dev/stderr"; exit 1} print a[1], start, end}' "$REGIONS" > "$BED"

if [[ ! -s "$BED" ]]; then
    echo "ERROR: No target intervals were generated." >&2
    exit 1
fi

# Interpret BAM-list paths from the working directory, as FreeBayes does.
BAM_COUNT=0
while IFS= read -r BAMFILE || [[ -n "$BAMFILE" ]]; do
    BAMFILE="${BAMFILE%$'\r'}"
    [[ -z "$BAMFILE" ]] && continue
    if [[ ! -r "$BAMFILE" ]]; then
        echo "ERROR: BAM in list is not readable: $BAMFILE" >&2
        exit 1
    fi
    BAM_COUNT=$((BAM_COUNT + 1))
done < "$BAMLIST"

if [[ "$BAM_COUNT" -eq 0 ]]; then
    echo "ERROR: BAM list contains no BAM paths." >&2
    exit 1
fi

# Input BAMs must be coordinate-sorted and indexed.
echo "Started: $(date)"
echo "Job ID: $JOB_ID"
echo "Requested memory: 64 GiB total on one node"
echo "BAM files: $BAM_COUNT"
echo "Target intervals: $(wc -l < "$BED")"
echo "Partial output: $PARTIAL"

# Original calling parameters are retained. Coverage limits are not RAM caps.
# A failed run leaves a clearly named partial file, not a completed output.
freebayes --targets "$BED" -f "$FASTA" -L "$BAMLIST" -k --genotype-qualities --skip-coverage 22000 --limit-coverage 80 --use-best-n-alleles 3 --ploidy 2 --min-mapping-quality 20 --min-base-quality 20 > "$PARTIAL"

if [[ ! -s "$PARTIAL" ]] || ! grep -q '^#CHROM' "$PARTIAL"; then
    echo "ERROR: FreeBayes returned without producing a VCF with a column header." >&2
    exit 1
fi

# Reaching this step requires FreeBayes to have exited successfully.
mv "$PARTIAL" "$OUT"
echo "VARIANT CALLING DONE: $(date)"
echo "Completed VCF: $OUT"

#END

#SBATCH --error=/scratch/project_2009316/EuSamples/06.VCF/filt/SpeciesSubsetVCF/species_masked_QC/slurm_logs/%x_%A_%a.err

# Runs VCFtools --missing-indv on each final site-filtered VCF.
# The resulting .imiss F_MISS values describe completeness AFTER site filtering;
# use them for documentation/QC summaries, not to repeat sample exclusions.

set -euo pipefail
module load bio-apps/v202603
module load bcftools

BASE="/scratch/project_2009316/EuSamples/06.VCF/filt/SpeciesSubsetVCF/species_masked_QC"
INPUT_ROOT="${BASE}/siteMiss10"

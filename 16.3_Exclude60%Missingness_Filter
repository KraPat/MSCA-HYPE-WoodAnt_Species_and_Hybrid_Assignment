#In each .imiss file, check that the report is complete and inspect F_MISS.
# It is each sample’s fraction of missing genotypes across the sites that remain in that group’s site-filtered VCF.
# The usual columns are:
    INDV: sample ID.
    N_DATA: number of variant sites assessed for that sample.
    N_GENOTYPES_FILTERED: genotypes filtered during the VCFtools run; since your command applies no additional genotype filters, this will usually be zero.
    N_MISS: number of missing genotypes.
    F_MISS: fraction missing; this is the main column to review.

#What to check
    Every expected sample appears once in its group’s report. The row count should match the number of samples in that final VCF.
    N_DATA is consistent across samples within a group and corresponds to the number of retained sites.
    Sort by F_MISS to identify samples that are still outliers relative to others in the same group.
    Summarize the median and maximum F_MISS for each group.

#Don’t expect every sample’s F_MISS to be at or below 10%. The 10% filter was applied site by site across samples; it does not impose a 10% missingness
# limit on each individual sample. And because these reports use the already-filtered sites, their F_MISS values will be lower 
# than the earlier pre-site-filter values. Use them to describe completeness of the final files, not to redo the sample-exclusion decision.
# First, we download the files. Then, we combine and summarize all reports in R like this:

#Download files
cd /root/EuSamples/06.VCF/GenomicOffset
rsync -av --prune-empty-dirs --include='*/' --include='*.imiss' --exclude='*' krapfpat@roihu-cpu.csc.fi:/scratch/project_2009316/EuSamples/06.VCF/filt/SpeciesSubsetVCF/species_masked_QC/ ./imiss_reports/


# Now, move to R and in R
library(dplyr)

#CHANGE BELOW
report_dir <- "/scratch/project_2009316/EuSamples/06.VCF/filt/SpeciesSubsetVCF/species_masked_QC/final_missingness"
files <- list.files(report_dir, pattern = "\\.imiss$", recursive = TRUE, full.names = TRUE)

imiss <- bind_rows(lapply(files, function(f) {
  x <- read.delim(f, check.names = FALSE)
  x$group <- basename(dirname(f))
  x
}))

imiss %>%
  group_by(group) %>%
  summarise(
    n_samples = n(),
    median_F_MISS = median(F_MISS, na.rm = TRUE),
    maximum_F_MISS = max(F_MISS, na.rm = TRUE),
    .groups = "drop"
  )

imiss %>%
  arrange(desc(F_MISS)) %>%
  select(group, INDV, N_DATA, N_MISS, F_MISS)

#Remember that aqui overlaps with aquiCentral and aquiScand, so those repeated samples appear in multiple group reports by design.







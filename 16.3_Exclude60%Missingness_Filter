if (( TASK_ID < 0 || TASK_ID >= ${#VCF_GROUPS[@]} )); then
  echo "ERROR: SLURM_ARRAY_TASK_ID=${TASK_ID} is outside 0-$(( ${#VCF_GROUPS[@]} - 1 ))." >&2
  exit 1
fi

GROUP="${VCF_GROUPS[$TASK_ID]}"
INPUT_VCF="${INPUT_ROOT}/${GROUP}/${GROUP}.DP8.GQ20.excl60.siteMiss10.recalcAN.vcf.gz"
OUTDIR="${OUTROOT}/${GROUP}"
PREFIX="${OUTDIR}/${GROUP}.DP8.GQ20.excl60.siteMiss10"
IMISS="${PREFIX}.imiss"

mkdir -p "$OUTDIR"

if ! command -v vcftools >/dev/null 2>&1; then
  echo "ERROR: vcftools is not on PATH; load/activate the correct environment." >&2
  exit 1
fi
if ! command -v bcftools >/dev/null 2>&1; then
  echo "ERROR: bcftools is not on PATH; load/activate the correct environment." >&2
  exit 1
fi
if [[ ! -r "$INPUT_VCF" ]]; then
  echo "ERROR: Input VCF not found/readable: $INPUT_VCF" >&2
  exit 1

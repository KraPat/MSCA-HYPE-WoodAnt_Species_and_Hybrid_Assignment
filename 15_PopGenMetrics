########################################################################################################################
#!/bin/bash
#SBATCH --job-name=IndividualHet
#SBATCH --account=project_2009316
#SBATCH --output=/scratch/project_2009316/EuSamples/06.VCF/logs/IndividualHet_%j.out
#SBATCH --error=/scratch/project_2009316/EuSamples/06.VCF/logs/IndividualHet_%j.err
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=12:00:00
#SBATCH --mem=8G

set -euo pipefail
module load bio-apps
module load bcftools
module load vcftools

# Save as 01_individual_HET.sh
# Submit: sbatch 01_individual_HET.sh /absolute/path/to/filtered.vcf.gz
# Create the SLURM logs directory before submission.
# Use autosomal diploid samples/regions only: exclude haploid males and mtDNA.
VCF="${1:?Usage: sbatch 01_individual_HET.sh /absolute/path/to/filtered.vcf.gz}"
BASE=/scratch/project_2009316/EuSamples/06.VCF/filt
SAMPLE_DIR="$BASE"
OUTDIR="$BASE/PopGenMetrics/IndividualHET"
mkdir -p "$OUTDIR"
[[ -r "$VCF" ]] || { echo "Cannot read VCF: $VCF" >&2; exit 1; }
shopt -s nullglob
# Ensure this pattern matches ONLY intended species lists, one sample per line.
LISTS=("$SAMPLE_DIR"/samples_*.txt)
((${#LISTS[@]} > 0)) || { echo "No species sample lists found" >&2; exit 1; }
printf 'Species\tSample\tN_called_diploid_SNPs\tN_heterozygous_SNPs\tH_obs_retained_SNPs\tN_missing_or_non_diploid_SNPs\tF_VCFtools\tN_sites_F\n' > "$OUTDIR/individual_HET_summary.tsv"

for LIST in "${LISTS[@]}"; do
    SPECIES=$(basename "$LIST" .txt)
    SPECIES=${SPECIES#samples_}
    WORK="$OUTDIR/$SPECIES"
    mkdir -p "$WORK"
    awk 'NF {gsub(/\r/, ""); print $1}' "$LIST" > "$WORK/samples.txt"
    N=$(wc -l < "$WORK/samples.txt")
    ((N >= 2)) || { echo "Skipping $SPECIES: need at least two samples for F" >&2; continue; }
    [[ $(sort -u "$WORK/samples.txt" | wc -l) -eq "$N" ]] || { echo "Duplicate sample IDs for $SPECIES" >&2; exit 1; }
    echo "Processing $SPECIES: $N samples"

    # Preserve species-fixed sites for observed SNP heterozygosity.
    bcftools view -S "$WORK/samples.txt" -m2 -M2 -v snps -Oz -o "$WORK/retained_sites.vcf.gz" "$VCF"
    bcftools index -f "$WORK/retained_sites.vcf.gz"
    N_SITES=$(bcftools index -n "$WORK/retained_sites.vcf.gz")
    ((N_SITES > 0)) || { echo "No retained SNPs for $SPECIES" >&2; exit 1; }

    # Directly count fully called biallelic diploid GTs at all retained sites.
    bcftools query -f '[%SAMPLE\t%GT\n]' "$WORK/retained_sites.vcf.gz" | awk 'BEGIN {OFS="\t"; print "Sample","N_called_diploid_SNPs","N_heterozygous_SNPs","H_obs_retained_SNPs","N_missing_or_non_diploid_SNPs"} {s=$1; seen[s]=1; n=split($2,a,/[|\/]/); if(n==2 && a[1] ~ /^[01]$/ && a[2] ~ /^[01]$/) {called[s]++; if(a[1]!=a[2]) het[s]++} else skipped[s]++} END {for(s in seen) print s,called[s]+0,het[s]+0,(called[s]>0 ? (het[s]+0)/called[s] : "NA"),skipped[s]+0}' > "$WORK/observed_heterozygosity.tsv"

    vcftools --gzvcf "$WORK/retained_sites.vcf.gz" --het --out "$WORK/inbreeding"

    # Standard .het columns: INDV O(HOM) E(HOM) N_SITES F.
    # Read F and N_SITES by HEADER NAME to avoid positional-column mistakes.
    awk -v sp="$SPECIES" 'BEGIN {OFS="\t"} FILENAME==ARGV[1] {if(FNR==1) next; s=$1; order[++k]=s; called[s]=$2; het[s]=$3; h[s]=$4; skipped[s]=$5; next} FILENAME==ARGV[2] {if(FNR==1) {for(j=1;j<=NF;j++) {if($j=="F") fi=j; if($j=="N_SITES") ni=j} if(!fi || !ni) {print "Unrecognized .het header" > "/dev/stderr"; bad=1; exit 1} next} f[$1]=$(fi); nf[$1]=$(ni)} END {if(!bad) for(i=1;i<=k;i++) {s=order[i]; print sp,s,called[s],het[s],h[s],skipped[s],(s in f ? f[s] : "NA"),(s in nf ? nf[s] : "NA")}}' "$WORK/observed_heterozygosity.tsv" "$WORK/inbreeding.het" >> "$OUTDIR/individual_HET_summary.tsv"
done

echo "Completed: $OUTDIR/individual_HET_summary.tsv"

# H_obs is heterozygous calls / fully called retained diploid SNPs, NOT per-base H.
# F measures heterozygote deficit/excess relative to this species sample; it is
# not proof of pedigree inbreeding. Population structure, admixture, relatedness,
# small samples, ascertainment and genotype quality can affect it. Negative F
# is possible. Use population-specific frequencies when appropriate and feasible.
# Compare missingness and consistent genotype filters across species.
# This script has no recombination-map dependency.


#####
# Now, we calculate ROH, regions of homozygosity

sbatch 15.4_Calculate_Roh.sh /scratch/project_2009316/EuSamples/06.VCF/filt/your_filtered_file.vcf.gz

########################################################################################################################
#!/bin/bash
#SBATCH --job-name=IndividualROH
#SBATCH --account=project_2009316
#SBATCH --output=/scratch/project_2009316/EuSamples/06.VCF/logs/IndividualROH_%j.out
#SBATCH --error=/scratch/project_2009316/EuSamples/06.VCF/logs/IndividualROH_%j.err
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=12:00:00
#SBATCH --mem=8G

set -euo pipefail
module load bio-apps
module load bcftools

# Save as 15.4_Calculate_Roh.sh
# Submit: sbatch 15.4_Calculate_Roh.sh /absolute/path/to/filtered.vcf.gz

# Standalone: no dependence on HET results.
# Use autosomal diploid samples/regions only; exclude haploid males and mtDNA.
VCF="${1:?Usage: sbatch 02_individual_ROH.sh /absolute/path/to/filtered.vcf.gz}"
BASE=/scratch/project_2009316/EuSamples/06.VCF/filt
SAMPLE_DIR="$BASE"
OUTDIR="$BASE/PopGenMetrics/IndividualROH"
RECMAP=/scratch/project_2009316/rufaRefGenome/Frufa_PR_May2026.recmap
MAPDIR="$OUTDIR/recombination_maps"
mkdir -p "$OUTDIR" "$MAPDIR"
[[ -r "$VCF" && -r "$RECMAP" ]] || { echo "Cannot read VCF or map" >&2; exit 1; }

GT_ERROR_PHRED=30
MIN_CALL_FRACTION=0.80
MIN_ROH_BP=100000
MIN_ROH_MARKERS=50
MIN_ROH_QUALITY=20
# Above are exploratory settings, not species-validated thresholds.

# Validate numeric fields FIRST, before sorting. Keep original line numbers.
# Accept position 0 as a possible map boundary; it is not alone proof of error.
# Input: chr pos cumulative_cM rate_cM_per_Mb. Never infer missing values as zero.
awk -v log="$MAPDIR/map_invalid_rows.tsv" 'BEGIN {OFS="\t"; print "Original_line","Reason","Original_record" > log; num="^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$"} NR==1 && $1=="chr" {next} NF==0 || /^#/ {next} {reason=""; if(NF!=4) reason="Expected four columns"; else if($1 ~ /[^A-Za-z0-9_.-]/) reason="Unsupported chromosome label"; else if($2 !~ /^[0-9]+$/) reason="Position is not a nonnegative integer"; else if($3 !~ num || $3+0<0) reason="Invalid cumulative cM"; else if($4 !~ num || $4+0<0) reason="Invalid local rate"; if(reason!="") {print NR,reason,$0 >> log; bad=1} else print $1,$2,$3,$4,NR} END {if(bad) {print "Invalid map rows: see " log > "/dev/stderr"; exit 1}}' "$RECMAP" > "$MAPDIR/map_validated.tsv"
[[ -s "$MAPDIR/map_validated.tsv" ]] || { echo "Map contains no data" >&2; exit 1; }
LC_ALL=C sort -k1,1 -k2,2n "$MAPDIR/map_validated.tsv" > "$MAPDIR/map_sorted.tsv"

# Report offending original rows, not only a generic chromosome:position error.
# Repeated physical positions require inspection, even if the values agree.
awk -v log="$MAPDIR/map_order_issues.tsv" -v summary="$MAPDIR/map_summary.tsv" 'BEGIN {OFS="\t"; print "CHROM","Position","Original_line","Previous_position","Previous_cM","Current_cM","Issue" > log; print "CHROM","N_points","First_pos","Last_pos","First_cM","Last_cM","Delta_cM" > summary} {c=$1; if(c in n) {if($2<=pos[c]) {print c,$2,$5,pos[c],cm[c],$3,"Duplicate physical position" >> log; bad=1} if($3+0<cm[c]+0) {print c,$2,$5,pos[c],cm[c],$3,"Decreasing cumulative cM" >> log; bad=1}} else {fp[c]=$2; fc[c]=$3} n[c]++; pos[c]=$2; cm[c]=$3} END {for(c in n) {print c,n[c],fp[c],pos[c],fc[c],cm[c],cm[c]-fc[c] >> summary; if(n[c]<2 || cm[c]+0<=fc[c]+0) {print c,pos[c],"NA",fp[c],fc[c],cm[c],"No overall cumulative cM increase" >> log; bad=1}} if(bad) {print "Map validation failed. Inspect " log " and " summary > "/dev/stderr"; exit 1}}' "$MAPDIR/map_sorted.tsv"

# BCFtools expects one map per chromosome, with cumulative cM in column THREE.
# Plateaus are allowed; the supplied cumulative map is not reconstructed.
awk -v dir="$MAPDIR" 'BEGIN {OFS="\t"} {c=$1; f=dir "/" c ".map"; if(!(c in seen)) {print "Position(bp)","Rate(cM/Mb)","Map(cM)" > f; close(f); seen[c]=1} print $2,$4,$3 >> f; close(f)}' "$MAPDIR/map_sorted.tsv"

shopt -s nullglob
# Ensure this pattern matches only intended species lists.
LISTS=("$SAMPLE_DIR"/samples_*.txt)
((${#LISTS[@]} > 0)) || { echo "No species sample lists found" >&2; exit 1; }
printf 'Species\tSample\tN_ROH\tTotal_ROH_bp\tLongest_ROH_bp\tN_species_ROH_markers\n' > "$OUTDIR/individual_ROH_summary.tsv"

for LIST in "${LISTS[@]}"; do
    SPECIES=$(basename "$LIST" .txt)
    SPECIES=${SPECIES#samples_}
    WORK="$OUTDIR/$SPECIES"
    mkdir -p "$WORK"
    awk 'NF {gsub(/\r/, ""); print $1}' "$LIST" > "$WORK/samples.txt"
    N=$(wc -l < "$WORK/samples.txt")
    ((N >= 2)) || { echo "Skipping $SPECIES: insufficient samples for frequency estimation" >&2; continue; }
    [[ $(sort -u "$WORK/samples.txt" | wc -l) -eq "$N" ]] || { echo "Duplicate sample IDs for $SPECIES" >&2; exit 1; }
    echo "Processing $SPECIES: $N samples"

    # Recalculate frequencies WITHIN the species, not across all species.
    bcftools view -S "$WORK/samples.txt" -m2 -M2 -v snps -Ou "$VCF" | bcftools +fill-tags -Oz -o "$WORK/species_sites.vcf.gz" -- -t AF,AN
    bcftools index -f "$WORK/species_sites.vcf.gz"
    bcftools view -i "INFO/AF>0 && INFO/AF<1 && INFO/AN>=2*$N*$MIN_CALL_FRACTION" -Oz -o "$WORK/roh_markers.vcf.gz" "$WORK/species_sites.vcf.gz"
    bcftools index -f "$WORK/roh_markers.vcf.gz"
    N_MARKERS=$(bcftools index -n "$WORK/roh_markers.vcf.gz")
    echo "$SPECIES: $N_MARKERS polymorphic ROH markers"

    if ((N_MARKERS > 0)); then
        # Confirm current map has each chromosome; avoid stale .map files.
        bcftools index -s "$WORK/roh_markers.vcf.gz" | awk '$3>0 {print $1}' > "$WORK/roh_chromosomes.txt"
        while IFS= read -r CHR; do
            awk -v c="$CHR" 'NR>1 && $1==c {found=1} END {exit !found}' "$MAPDIR/map_summary.tsv" || { echo "Missing current map for $CHR" >&2; exit 1; }
        done < "$WORK/roh_chromosomes.txt"

        # Warn about markers beyond map endpoints. Review coverage before final
        # interpretation; do not extend maps without justified assumptions.
        bcftools query -f '%CHROM\t%POS\n' "$WORK/roh_markers.vcf.gz" | awk 'FILENAME==ARGV[1] {if(FNR>1) {lo[$1]=$3; hi[$1]=$4} next} {if($2<lo[$1] || $2>hi[$1]) outside[$1]++} END {for(c in outside) print "WARNING: " c ": " outside[c] " markers outside map endpoints" > "/dev/stderr"}' "$MAPDIR/map_summary.tsv" -
        bcftools roh --AF-tag AF -G "$GT_ERROR_PHRED" --genetic-map "$MAPDIR/{CHROM}.map" -O r -o "$WORK/roh_raw.txt" "$WORK/roh_markers.vcf.gz"
    else
        echo "WARNING: no informative markers for $SPECIES; ROH results will be NA" >&2
        : > "$WORK/roh_raw.txt"
    fi

    # Region output: RG sample CHROM start end length markers quality.
    awk -v bp="$MIN_ROH_BP" -v markers="$MIN_ROH_MARKERS" -v q="$MIN_ROH_QUALITY" 'BEGIN {OFS="\t"; print "Record","Sample","CHROM","Start","End","Length_bp","N_markers","Quality"} $1=="RG" && $6>=bp && $7>=markers && $8>=q {print $1,$2,$3,$4,$5,$6,$7,$8}' "$WORK/roh_raw.txt" > "$WORK/roh_filtered.tsv"
    awk -v m="$N_MARKERS" 'BEGIN {OFS="\t"; print "Sample","N_ROH","Total_ROH_bp","Longest_ROH_bp","N_species_ROH_markers"} FILENAME==ARGV[1] {samples[$1]=1; next} FILENAME==ARGV[2] && FNR>1 {s=$2; n[s]++; total[s]+=$6; if($6>longest[s]) longest[s]=$6} END {for(s in samples) if(m>0) print s,n[s]+0,total[s]+0,longest[s]+0,m; else print s,"NA","NA","NA",m}' "$WORK/samples.txt" "$WORK/roh_filtered.tsv" > "$WORK/roh_summary.tsv"
    awk -v sp="$SPECIES" 'BEGIN {OFS="\t"} NR>1 {print sp,$0}' "$WORK/roh_summary.tsv" >> "$OUTDIR/individual_ROH_summary.tsv"
done

echo "Completed: $OUTDIR/individual_ROH_summary.tsv"

# IMPORTANT:
# Map diagnostics stop only this ROH job, not the independent HET job.
# Inspect original map records; do not silently delete duplicates or integrate
# local rates without knowing their provenance and interval interpretation.
# The Admi1 hybrid map is an approximation for other species, even on the same
# reference assembly. Frequency estimates in admixed/structured groups also
# warrant caution. Use appropriate frequency panels when feasible.
# Sparse markers and large coverage gaps can inflate inferred physical spans;
# inspect density and apply appropriate genomic masks/gap handling before final
# inference. Test sensitivity to ROH thresholds and GT-error assumptions.
# Zero ROH is no detected/retained ROH, not proof of absence of inbreeding.
# Total_ROH_bp is NOT F_ROH. F_ROH needs an appropriately assessed diploid-genome
# denominator, with both ROH spans and denominator referring to the same regions.







